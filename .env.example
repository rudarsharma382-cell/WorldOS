# WorldOS Environment Configuration Example
# Copy this file to .env and insert your personal API keys

# Mapbox Token for 3D Globe & Satellite Static Imagery
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here
MAPBOX_TOKEN=your_mapbox_token_here

# Hugging Face Inference API Token
HF_TOKEN=your_huggingface_token_here
HUGGINGFACE_TOKEN=your_huggingface_token_here

# NASA APIs
NASA_API_KEY=DEMO_KEY
NASA_FIRMS_MAP_KEY=your_nasa_firms_key_here

# Unsplash API
UNSPLASH_ACCESS_KEY=your_unsplash_access_key
UNSPLASH_KEY=your_unsplash_access_key
UNSPLASH_SECRET_KEY=your_unsplash_secret_key

# AIS Live Stream & Webcams
AIS_STREAM_KEY=your_ais_stream_key
WINDY_WEBCAM_API_KEY=your_windy_key
